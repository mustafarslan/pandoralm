# Pandora Cortex Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pandora123

# LanceDB Vector Database (embedded)
LANCEDB_PATH=./storage/lancedb

# Redis (Celery Broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# PostgreSQL
DATABASE_URL=postgresql://pandora:pandora@localhost:5432/pandora

# Keycloak Identity Provider
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=pandora
KEYCLOAK_CLIENT_ID=pandora-cortex
KEYCLOAK_CLIENT_SECRET=

# LLM Configuration
OPENAI_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_LLM_MODEL=gpt-4o-mini

# Tiered Inference (Router = fast classification, Solver = heavy reasoning)
# Router: gemma3:1b or llama-3.2:1b for <300ms classification
# Solver: deepseek-r1:8b or gpt-4o for complex reasoning
LLM_PROVIDER=ollama
LLM_ROUTER_MODEL=gemma3:1b
LLM_SOLVER_MODEL=deepseek-r1:8b
LLM_ROUTER_API_BASE=http://localhost:11434
LLM_SOLVER_API_BASE=http://localhost:11434

# GraphRAG
GRAPHRAG_CACHE_DIR=./storage/graphrag
