# =============================================================================
# PandoraLM Environment Configuration - Windows (NVIDIA GPU)
# Optimized for RTX 3090/4090/5090 (CUDA, Tensor Cores)
# =============================================================================

# Compute Device (NVIDIA CUDA)
COMPUTE_DEVICE='cuda'

# Embedding Strategy
# ONNX Runtime with CUDA Execution Provider offers best throughput
EMBEDDING_PROVIDER='onnx'
DEFAULT_EMBEDDING_MODEL='all-MiniLM-L6-v2'

# Performance Tuning
# Windows Scheduler handles threads well; enable high concurrency
PANDORA_WORKER_THREADS=16
PANDORA_WORKER_PROCESSES=8

# Batch Sizes (High VRAM on RTX 3090/4090 allows massive batches)
EMBEDDING_BATCH_SIZE=512
EMBEDDING_CONCURRENCY=10

# Ollama (Local LLM)
# Assume Ollama runs in separate WSL2 instance or native Windows
OLLAMA_BASE_URL='http://host.docker.internal:11434'
LLM_PROVIDER='ollama'

# GraphRAG
# GPU acceleration speeds up extraction significantly
GRAPHRAG_CONCURRENCY=5
GRAPHRAG_BATCH_SIZE=50

# Memory (Vector Store)
VECTOR_DB='lancedb'
LANCEDB_PATH='/app/storage/lancedb'
