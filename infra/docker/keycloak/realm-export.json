            "credentials": [
                {
                    "type": "password",
                    "value": "admin",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "admin",
                "vector_ops",
                "researcher"
            ]
        },
        {
            "username": "user",
            "enabled": true,
            "email": "user@pandora.ai",
            "firstName": "User",
            "credentials": [
                {
                    "type": "password",
                    "value": "user",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "researcher"
