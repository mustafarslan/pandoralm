        },
        {
            "username": "mustafa",
            "enabled": true,
            "email": "admin@example.com",
            "firstName": "Mustafa",
            "lastName": "Arslan",
            "credentials": [
                {
                    "type": "password",
                    "value": "admin",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "admin",
                "vector_ops",
                "researcher"
            ]
        }
    ],
    "roles": {
        "realm": [
            {
                "name": "admin",
                "description": "System Administrator"
            },
            {
                "name": "vector_ops",
                "description": "Can manage vector embeddings"
            },
            {
                "name": "researcher",
                "description": "Can perform deep research"
            }
        ]
    },
    "clients": [
        {
            "clientId": "pandora-core",
            "enabled": true,
            "publicClient": true,
            "redirectUris": [
                "http://localhost:3001/*",
                "http://localhost:3002/*"
            ],
            "webOrigins": [
                "http://localhost:3001",
                "http://localhost:3002"
            ],
            "protocol": "openid-connect"
        },
        {
            "clientId": "pandora-cortex",
            "enabled": true,
            "publicClient": false,
            "secret": "cortex-secret",
            "serviceAccountsEnabled": true,
            "directAccessGrantsEnabled": true,
            "redirectUris": [
                "http://localhost:8000/*",
                "http://localhost:3002/*"
            ],
            "webOrigins": [
                "http://localhost:8000",
                "http://localhost:3002"
            ],
            "protocol": "openid-connect"
        },
        {
            "clientId": "pandora-frontend",
            "enabled": true,
            "publicClient": true,
            "redirectUris": [
                "http://localhost:3002/*"
            ],
            "webOrigins": [
                "http://localhost:3002"
            ],
            "protocol": "openid-connect",
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true
        }
    ],
    "groups": [
        {
            "name": "Engineering",
            "path": "/Engineering",
            "attributes": {
                "workspace_id": [
                    "workspace-engineering"
                ]
            }
        },
        {
            "name": "Legal",
            "path": "/Legal",
            "attributes": {
                "workspace_id": [
                    "workspace-legal"
                ]
            }
        }
    ]
}