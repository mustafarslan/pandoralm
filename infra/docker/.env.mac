# =============================================================================
# PandoraLM Environment Configuration - macOS (Apple Silicon)
# Optimized for M1/M2/M3/M4 Max Chips (Unified Memory, Metal/MPS)
# =============================================================================

# Compute Device (Metal Performance Shaders)
COMPUTE_DEVICE='mps'

# Embedding Strategy
# SentenceTransformers with MPS support is currently most stable for macOS
EMBEDDING_PROVIDER='sentence-transformers'
DEFAULT_EMBEDDING_MODEL='all-MiniLM-L6-v2'

# Performance Tuning
# M-series chips have high core counts; enable parallel workers
PANDORA_WORKER_THREADS=8
PANDORA_WORKER_PROCESSES=4

# Batch Sizes (Unified memory allows larger batches than typical consumer GPUs)
EMBEDDING_BATCH_SIZE=256
EMBEDDING_CONCURRENCY=5

# Ollama (Local LLM)
# Assume Ollama serves via localhost
OLLAMA_BASE_URL='http://host.docker.internal:11434'
LLM_PROVIDER='ollama'

# GraphRAG
# CPU/MPS is decent for extraction, but keep concurrency moderate to avoid UI lag
GRAPHRAG_CONCURRENCY=3
GRAPHRAG_BATCH_SIZE=20

# Memory (Vector Store)
VECTOR_DB='lancedb'
LANCEDB_PATH='/app/storage/lancedb'
